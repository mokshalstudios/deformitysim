  "dtype": "float32"
 },
 "preprocess": {
  "resizeTo": [
   1024,
   512
  ],
  "resizeToNote": "[h, w]; cv2.resize(image, (512, 1024)) default INTER_LINEAR",
  "aspect": "stretch",
  "colorOrder": "BGR",
  "formula": "x = pixel / 255 - 0.5   (per channel, no per-image normalization)",
  "scale": 0.00392156862745098,
  "mean": [
   0.5,
   0.5,
   0.5
  ],
  "std": [
   1.0,
   1.0,
   1.0
  ],
  "meanStdNote": "mean is subtracted AFTER scaling by 1/255; equivalently (pixel - 127.5) / 255",
  "valueRange": [
   -0.5,
   0.5
  ]
 },
 "outputs": [
  {
   "name": "hm",
   "tfjsNodeName": "Identity",
   "signatureTensor": "Identity:0",
   "shape": [
    1,
    256,
    128,
    1
   ],
   "layout": "NHWC",
   "activation": "sigmoid (already applied in graph)"
  },
  {
   "name": "reg",
   "tfjsNodeName": "Identity_1",
   "signatureTensor": "Identity_1:0",
   "shape": [
    1,
    256,
    128,
    2
   ],
   "layout": "NHWC",
   "channels": [
    "dx",
    "dy"
   ],
   "unit": "heatmap cells"
  },
  {
   "name": "wh",
   "tfjsNodeName": "Identity_2",
   "signatureTensor": "Identity_2:0",
   "shape": [
    1,
    256,
    128,
    8
   ],
   "layout": "NHWC",
   "channels": [
    "tl_x",
    "tl_y",
    "tr_x",
    "tr_y",
    "bl_x",
    "bl_y",
    "br_x",
    "br_y"
   ],
   "unit": "heatmap cells",
   "semantics": "center - corner"
  }
 ],
 "outputOrderNote": "model.execute(x) returns [hm, reg, wh] in model.outputs order (Identity, Identity_1, Identity_2). Safest: model.execute(x, ['Identity','Identity_1','Identity_2']) or identify by last-dim channel count 1/2/8.",
 "downRatio": 4,
 "heatmapSize": [
  256,
  128
 ],
 "decode": {
  "nmsKernel": 3,
  "nmsNote": "3x3 max-pool, stride 1, pad 1; keep cells equal to local max, others -> 0",
  "topK": 17,
  "topKNote": "DecDecoder hard-codes self.K = 17 regardless of --K (default 100)",
  "confThresh": 0.2,
  "confThreshNote": "main.py default --conf_thresh 0.2 but ctdet_decode never applies it; test.py draws all 17. Apply it yourself for display.",
  "center": "cx = (ix + reg[0]) * downRatio ; cy = (iy + reg[1]) * downRatio   (input-pixel coords, 512x1024)",
  "cornerOrder": [
   "tl",
   "tr",
   "bl",
   "br"
  ],
  "corner": "corner_i = ((ix + reg[0]) - wh[2i], (iy + reg[1]) - wh[2i+1]) * downRatio",
  "toOriginal": "x_orig = x_input * origW / 512 ; y_orig = y_input * origH / 1024",
  "sortForDisplay": "test.py sorts the 17 detections by center y ascending before drawing",
  "referenceJs": "decode_reference.js (decodeSpineLandmarks, spineLandmarksToOriginal, spinePreprocessRGBA)"
 },
